# Copie para .env.local e preencha. Só chaves PÚBLICAS: o painel nunca usa service_role
# (o banco garante o acesso de admin via RLS/RPC).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_API_URL=http://localhost:8000
# App (Expo web) dono do login. Em produção: a origem do próprio domínio.
NEXT_PUBLIC_APP_URL=http://localhost:8081
