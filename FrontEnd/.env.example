# Copie este arquivo para .env na raiz de FrontEnd/ e preencha.

# Supabase Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=coloque_aqui_a_anon_key

# BackEnd/API rodando localmente. Em dispositivo físico, trocar localhost
# pelo IP da máquina na rede (ex. http://192.168.0.10:8000).
EXPO_PUBLIC_API_URL=http://localhost:8000
