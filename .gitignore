# ========================================
# Routify — root .gitignore
# Cobre Python (apps/api, services/, ml/), Node (apps/mobile, apps/admin), IDE, OS, segredos.
# ========================================

# ---- Segredos e variáveis de ambiente ----
.env
.env.*
!.env.example
*.key
*secret*
*credentials*

# Chaves específicas do projeto — em qualquer pasta
**/tomtom_keys.json
services/collector/config/.env

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# venv Python dentro das pastas Python (nunca `lib/` solto: engolia apps/mobile/src/lib)
apps/api/**/lib/
services/**/lib/
ml/**/lib/
apps/api/**/lib64/
services/**/lib64/
ml/**/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
.env/

# Pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Jupyter
.ipynb_checkpoints/

# ---- Modelos ML / artefatos pesados ----
ml/artifacts/*.pkl
ml/artifacts/*.parquet
ml/artifacts/*.graphml
ml/artifacts/mlruns/
mlruns/
*.h5
*.onnx

# Cache OSMnx
cache/
.osmnx_cache/

# ---- Node / Expo / React Native ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak

# Expo
.expo/
.expo-shared/
dist/
web-build/
*.jks
*.p8
*.p12
*.mobileprovision
*.orig.*

# Metro
.metro-health-check*

# ---- TypeScript / JavaScript build ----
*.tsbuildinfo
.next/
out/

# ---- IDE / Editores ----
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.history/

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Logs / temporários ----
*.log
logs/
tmp/
temp/

# ---- Docs build ----
docs/build/
*.pdf.bak

# ---- Claude / IA assistants ----
.claude/
.claude.json
.claude.json.backup
.mcp.json
.clauderc

# ---- Markdown interno (notas soltas de execução/auditoria ficam fora) —
# mantém READMEs, a spec viva (CLAUDE.md), as docs vivas (docs/) e o
# planejamento GSD (.planning/) ----
*.md
!README.md
!**/README.md
!CLAUDE.md
!docs/**/*.md
!.planning/**/*.md

# SQL local (pode conter e-mails/dados pessoais) — nunca versionar
supabase/.local/
