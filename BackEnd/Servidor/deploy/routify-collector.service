[Unit]
Description=Routify — coletor de tráfego + Fase 3 (LIA vs. TomTom)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ajuste o usuário e os caminhos para o que existir na VM.
User=routify
WorkingDirectory=/home/routify/Routify/BackEnd/Servidor
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/routify/Routify/BackEnd/Servidor/venv/bin/python main.py
Restart=always
RestartSec=15

# Fase 3 sozinha pode passar de 1GB de RAM por alguns segundos (grafo de
# 38km carregado do zero a cada rodada agendada). Sem limite aqui — se a VM
# tiver RAM insuficiente, prefira reduzir o radius do grafo ou o OCPU/RAM da
# instância a impor um MemoryMax que mata o processo no pior momento.

[Install]
WantedBy=multi-user.target
